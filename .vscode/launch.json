{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "本地测试 graph.py",
            "type": "debugpy",
            "request": "launch",
            "module": "app.agent.graph",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "▶ 启动 FastAPI (Debug模式，推荐)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "jinja": true
        },
        {
            "name": "🔗 Attach 到终端启动的进程",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            }
        }
    ]
}
